# Copy to .env.local and fill in from your Supabase project dashboard
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for server actions and Edge Functions that
# bypass RLS (cost rollup, OCR, nightly prep generation). Never prefix
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic-link emails should redirect back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
